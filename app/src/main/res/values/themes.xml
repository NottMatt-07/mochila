<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema general (DayNight: se adapta al modo claro u oscuro del celular) -->
    <style name="Theme.Mochila" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/azul</item>
        <item name="colorPrimaryVariant">@color/azul_oscuro</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorSecondary">@color/ambar</item>
        <item name="colorSecondaryVariant">@color/ambar</item>
        <item name="colorOnSecondary">@color/tinta</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/tinta</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/barra_estado</item>
        <item name="android:navigationBarColor">@color/superficie</item>
        <item name="android:windowBackground">@color/fondo</item>
    </style>

    <!-- Variante sin barra superior, para Bienvenida y las pantallas con barra de navegación -->
    <style name="Theme.Mochila.SinBarra">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Título grande de las pantallas principales -->
    <style name="Mochila.Titulo" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/tinta</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Título de cada tarjeta o sección -->
    <style name="Mochila.Seccion" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/tinta</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Tarjetas redondeadas -->
    <style name="Mochila.Tarjeta" parent="">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">1dp</item>
    </style>

</resources>
