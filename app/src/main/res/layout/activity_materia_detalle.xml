<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <!-- Pestañas: Tareas o Notas -->
    <RadioGroup
        android:id="@+id/rgVista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <RadioButton
            android:id="@+id/rbTareas"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:checked="true"
            android:text="Tareas"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/rbNotas"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Notas"
            android:textSize="16sp" />
    </RadioGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaDetalle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="14dp" />

        <TextView
            android:id="@+id/txtVacioDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="@color/gris"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/btnAgregarDetalle"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_margin="16dp"
        android:textAllCaps="false"
        android:textSize="17sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_mas"
        app:iconGravity="textStart" />

</LinearLayout>
