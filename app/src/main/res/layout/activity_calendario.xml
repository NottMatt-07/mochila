<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <TextView
        style="@style/Mochila.Titulo"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:text="Calendario" />

    <!-- Mes con sus días -->
    <androidx.cardview.widget.CardView
        style="@style/Mochila.Tarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnMesAnterior"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mes anterior"
                    android:src="@drawable/ic_anterior"
                    app:tint="@color/tinta" />

                <TextView
                    android:id="@+id/txtMes"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:textColor="@color/tinta"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnMesSiguiente"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mes siguiente"
                    android:src="@drawable/ic_siguiente"
                    app:tint="@color/tinta" />
            </LinearLayout>

            <!-- Iniciales de los días de la semana (de lunes a domingo) -->
            <LinearLayout
                android:id="@+id/filaDiasSemana"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gridDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/txtDiaElegido"
        style="@style/Mochila.Seccion"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="20dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaDelDia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="96dp" />

        <TextView
            android:id="@+id/txtVacioDia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:text="Nada para este día.\nTocá + para agendar algo."
            android:textColor="@color/gris"
            android:textSize="15sp"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAgregarEnDia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="Agregar tarea en este día"
            android:src="@drawable/ic_mas"
            app:backgroundTint="@color/azul"
            app:tint="@color/blanco" />
    </FrameLayout>

    <include layout="@layout/barra_navegacion" />

</LinearLayout>
