<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <TextView
        style="@style/Mochila.Titulo"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:text="Pomodoro" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtModo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estudio"
                android:textColor="@color/gris"
                android:textSize="18sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progresoPomodoro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:max="1000"
                    android:progress="1000"
                    app:indicatorColor="@color/azul"
                    app:indicatorSize="240dp"
                    app:trackColor="@color/borde"
                    app:trackCornerRadius="7dp"
                    app:trackThickness="14dp" />

                <TextView
                    android:id="@+id/txtTiempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="25:00"
                    android:textColor="@color/tinta"
                    android:textSize="56sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="¿Qué estás estudiando?"
                android:textColor="@color/tinta"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spMateriaPomodoro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Modo demostración (bloques de 10 segundos)"
                android:textColor="@color/tinta"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnIniciar"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Iniciar"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReiniciar"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Reiniciar"
                    android:textAllCaps="false"
                    android:textColor="@color/tinta"
                    android:textSize="18sp"
                    app:cornerRadius="16dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtResumenHoy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/tinta"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_navegacion" />

</LinearLayout>
