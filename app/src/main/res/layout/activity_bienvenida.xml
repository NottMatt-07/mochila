<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azul"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:id="@+id/marcoLogo"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:background="@drawable/bg_logo_blanco">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:contentDescription="@string/logo_descripcion"
            android:src="@drawable/ic_logo" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/contenidoBienvenida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_name"
            android:textColor="@color/blanco"
            android:textSize="52sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="300dp"
            android:text="@string/eslogan"
            android:textColor="@color/texto_sobre_azul"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:text="Recordatorios antes de cada examen"
            android:textColor="@color/blanco"
            android:textSize="17sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_check_ambar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:text="Todo ordenado por materia"
            android:textColor="@color/blanco"
            android:textSize="17sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_check_ambar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:text="Pomodoro para concentrarte"
            android:textColor="@color/blanco"
            android:textSize="17sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_check_ambar" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnEmpezar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="Empezar"
        android:textAllCaps="false"
        android:textColor="@color/tinta"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/ambar"
        app:cornerRadius="16dp" />

</LinearLayout>
