<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <!-- Encabezado con el logo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/logo_descripcion"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/tinta"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHoy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gris"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtTituloInicio"
        style="@style/Mochila.Titulo"
        android:layout_marginTop="18dp"
        android:paddingHorizontal="20dp"
        android:text="Lo que viene" />

    <TextView
        android:id="@+id/txtResumen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:textColor="@color/gris"
        android:textSize="15sp" />

    <!-- Pestañas: pendientes o archivo de tareas hechas -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoVista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        app:checkedButton="@+id/btnPendientes"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPendientes"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Pendientes"
            android:textAllCaps="false"
            android:textColor="@color/tinta"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHechas"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Hechas"
            android:textAllCaps="false"
            android:textColor="@color/tinta"
            android:textSize="15sp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:id="@+id/contenidoInicio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaTareas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="96dp" />

        <!-- Estado vacío -->
        <LinearLayout
            android:id="@+id/grupoVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgVacio"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:alpha="0.9"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo" />

            <TextView
                android:id="@+id/txtVacioTitulo"
                style="@style/Mochila.Seccion"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtVacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/gris"
                android:textSize="15sp" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAgregar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="Agregar tarea"
            android:src="@drawable/ic_mas"
            app:backgroundTint="@color/azul"
            app:tint="@color/blanco" />
    </FrameLayout>

    <include layout="@layout/barra_navegacion" />

</LinearLayout>
