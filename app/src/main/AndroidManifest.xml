<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necesario en Android 13 o superior para mostrar notificaciones -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Para volver a programar los recordatorios cuando se reinicia el celular -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mochila">

        <activity
            android:name=".BienvenidaActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Mochila.SinBarra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Mochila.SinBarra" />

        <activity
            android:name=".NuevaTareaActivity"
            android:exported="false"
            android:label="Nueva tarea"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MateriasActivity"
            android:exported="false"
            android:label="Materias"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Mochila.SinBarra" />

        <activity
            android:name=".MateriaDetalleActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".NotaActivity"
            android:exported="false"
            android:label="Nota"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PomodoroActivity"
            android:exported="false"
            android:label="Pomodoro"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Mochila.SinBarra" />

        <activity
            android:name=".CalendarioActivity"
            android:exported="false"
            android:label="Calendario"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Mochila.SinBarra" />

        <activity
            android:name=".ProgresoActivity"
            android:exported="false"
            android:label="Progreso"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Mochila.SinBarra" />

        <receiver
            android:name=".RecordatorioReceiver"
            android:exported="false" />

        <receiver
            android:name=".ReinicioReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
